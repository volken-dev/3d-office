  "agentStates": {
    "_format": "state -> { note, color, slots: [{ pois, clip, assign? }] }. color = statusColors key: the robot's body (material primary) and its desk / bay light (status_glow). Slots fill IN ORDER: an agent takes the first free POI of the first slot that still has one, so overflow slots (poi-stand-<zone>-*, generated standing spots) come last. pois are POI node names; 'poi-x-*' = every POI of that kind. assign 'own' = the agent's own POI of that kind (poi-<kind>-<desk id>: its desk, its charging bay). Every state holds at least agents.max agents.",
    "working": {
      "note": "at its own desk, typing",
      "color": "green",
      "slots": [
        {
          "pois": ["poi-sit_work-*"],
          "clip": "Sit_Work",
          "assign": "own"
        }
      ]
    },
    "shipping": {
      "note": "deploying: hammering and tinkering at the workbenches on the deploy line",
      "color": "green",
      "slots": [
        {
          "pois": ["poi-ship-1", "poi-ship-3", "poi-ship-5", "poi-ship-7"],
          "clip": "Hammer"
        },
        {
          "pois": ["poi-ship-2", "poi-ship-4", "poi-ship-6", "poi-ship-8"],
          "clip": "Tinker"
        },
        {
          "pois": ["poi-stand-deploy-*"],
          "clip": "LookAround"
        }
      ]
    },
    "waiting_for_input": {
      "note": "at its own desk with a '?' until the user replies",
      "color": "orange",
      "slots": [
        {
          "pois": ["poi-sit_work-*"],
          "clip": "Sit_Wait",
          "assign": "own"
        }
      ]
    },
    "idle": {
      "note": "in the lounge, the reading nook or at the coffee bar",
      "color": "yellow",
      "slots": [
        {
          "pois": ["poi-sit_idle-*"],
          "clip": "Sit_Idle"
        },
        {
          "pois": ["poi-coffee_chat-*"],
          "clip": "Talk"
        },
        {
          "pois": ["poi-use_coffee-1"],
          "clip": "Idle"
        },
        {
          "pois": ["poi-stand-lounge-*"],
          "clip": "Idle"
        }
      ]
    },
    "paused_or_rate_limited": {
      "note": "sits at its own charging bay in the server room, plugs in, snoozes",
      "color": "yellow",
      "slots": [
        {
          "pois": ["poi-charge-*"],
          "clip": "Charge",
          "assign": "own"
        }
      ]
    },
    "error": {
      "note": "slumped at its own desk with a '!'",
      "color": "red",
      "slots": [
        {
          "pois": ["poi-sit_work-*"],
          "clip": "Sit_Sad",
          "assign": "own"
        }
      ]
    },
    "done": {
      "note": "dances in place on the production line (its workbench, or a spot on the factory floor), then is retired",
      "color": "green",
      "slots": [
        {
          "pois": ["poi-ship-*"],
          "clip": "Dance"
        },
        {
          "pois": ["poi-stand-deploy-*"],
          "clip": "Dance"
        }
      ]
    },
    "arrive": {
      "note": "walks in at the door and waves",
      "color": "yellow",
      "slots": [
        {
          "pois": ["poi-idle-spawn-*"],
          "clip": "Wave"
        },
        {
          "pois": ["poi-stand-entry-*"],
          "clip": "Wave"
        }
      ]
    },
    "queued": {
      "note": "a session beyond agents.max: waits by the door for a free pod (FIFO; its queue position N picks poi-stand-entry-N, 1 = nearest the door), then takes the freed slot",
      "color": "yellow",
      "slots": [
        {
          "pois": ["poi-stand-entry-*"],
          "clip": "LookAround",
          "assign": "position"
        }
      ]
    }
  }
}
