# Copy to apps/web/.env.local (git-ignored). Everything here is inlined into the static bundle: never put secrets in it.

# Origin of the Hono LLM gateway in apps/api (see apps/api/.env.example). Every model call goes through it, via
# src/lib/api-client.ts; the browser never holds a provider key.
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Public origin the site is served from, used for absolute Open Graph and Twitter preview URLs.
# NEXT_PUBLIC_SITE_URL=https://example.com
