{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun scripts/copy-scene-assets.ts",
    "dev": "next dev -p 3000 -H localhost",
    "predev:lan": "bun scripts/copy-scene-assets.ts",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "prebuild": "bun scripts/copy-scene-assets.ts",
    "build": "next build",
    "postbuild": "node scripts/csp.mjs out",
    "start": "serve out -l 3000",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "clean": "rm -rf .next out",
    "test": "bun test"
  },
  "dependencies": {
    "@the-delegation/agents": "workspace:*",
    "@the-delegation/llm": "workspace:*",
    "@the-delegation/scene": "workspace:*",
