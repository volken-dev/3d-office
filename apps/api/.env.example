# Copy to apps/api/.env (git-ignored). Bun loads it automatically for `bun run dev` / `bun run start`.

# Server-held Claude key; required. Never expose it through a NEXT_PUBLIC_* variable in apps/web.
ANTHROPIC_API_KEY=

# Server-held OpenAI key for outage fallback; optional. Without it, Claude outages surface as errors.
OPENAI_API_KEY=

# Comma-separated origins allowed by CORS. Empty means no cross-origin browser access.
ALLOWED_ORIGINS=http://localhost:3000

# Requests per minute per client IP on /api/llm/* (in-memory limiter, dev only).
RATE_LIMIT_PER_MINUTE=20

HOST=127.0.0.1
PORT=8787
