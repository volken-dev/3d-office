{
  "name": "api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@the-delegation/llm": "workspace:*",
    "@the-delegation/shared": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "~5.9.3"
  }
}
